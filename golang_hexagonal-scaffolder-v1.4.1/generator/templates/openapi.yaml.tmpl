{{/* template: openapi.yaml.tmpl
   Schema-aware: emits OpenAPI 3.0 paths for every introspected table.
   Since 1.4.0. */}}
openapi: 3.0.3
info:
  title: Generated Hexagonal API
  version: 1.4.0
  license:
    name: Apache-2.0
servers:
  - url: http://localhost:8080
paths:
  /health:
    get:
      summary: Combined health
      responses:
        "200": { description: healthy }
        "503": { description: unavailable }
  /health/live:
    get:
      summary: Liveness
      responses:
        "200": { description: alive }
  /health/ready:
    get:
      summary: Readiness
      responses:
        "200": { description: ready }
        "503": { description: not ready }
  /metrics:
    get:
      summary: Prometheus metrics
      responses:
        "200": { description: prometheus text }
  /auth/token:
    post:
      summary: Issue a JWT
      responses:
        "200": { description: token }
{{range .Tables}}  /{{.RouteName}}:
    get:
      summary: List {{.EntityName}}
      security: [{ bearerAuth: [] }]
      responses:
        "200": { description: list }
        "401": { $ref: "#/components/responses/Error" }
        "429": { $ref: "#/components/responses/Error" }
    post:
      summary: Create {{.EntityName}}
      security: [{ bearerAuth: [] }]
      responses:
        "201": { description: created }
        "400": { $ref: "#/components/responses/Error" }
        "409": { $ref: "#/components/responses/Error" }
  /{{.RouteName}}/{id}:
    get:
      summary: Get {{.EntityName}} by id
      security: [{ bearerAuth: [] }]
      parameters:
        - in: path
          name: id
          required: true
          schema: { type: string }
      responses:
        "200": { description: found }
        "404": { $ref: "#/components/responses/Error" }
    put:
      summary: Update {{.EntityName}}
      security: [{ bearerAuth: [] }]
      parameters:
        - in: path
          name: id
          required: true
          schema: { type: string }
      responses:
        "200": { description: updated }
        "404": { $ref: "#/components/responses/Error" }
    delete:
      summary: Delete {{.EntityName}}
      security: [{ bearerAuth: [] }]
      parameters:
        - in: path
          name: id
          required: true
          schema: { type: string }
      responses:
        "204": { description: deleted }
        "404": { $ref: "#/components/responses/Error" }
{{end}}components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
  responses:
    Error:
      description: error
      content:
        application/json:
          schema: { $ref: "#/components/schemas/Error" }
  schemas:
    Error:
      type: object
      properties:
        code: { type: string }
        message: { type: string }
        reqId: { type: string }
