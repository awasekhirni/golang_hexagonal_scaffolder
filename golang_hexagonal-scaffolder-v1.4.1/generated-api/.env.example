# generated-api/.env.example
# Copy to ../.env (root) and fill in. docker-compose reads from there.

POSTGRES_USER=hexapi
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=hexapi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_CONN_TIMEOUT=5

HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_RPM=100
GRACEFUL_SHUTDOWN_TIMEOUT=5

LOG_LEVEL=INFO
HEXAPI_LOG_LEVEL=DEBUG
LOG_FORMAT=json

JWT_SECRET=__REPLACE_ME__
JWT_ISSUER=hexapi
JWT_TTL_MINUTES=60
