# generator/.env.example
# Copy to .env and fill in. The generator reads these via os.Getenv; load them
# with `export $(grep -v '^#' .env | xargs)` or your shell's equivalent.

POSTGRES_USER=hexapi
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=hexapi_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Generator-only tuning (small pool — introspection is light).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONN_TIMEOUT=5

GENERATOR_OUTPUT_DIR=./out
GENERATOR_MODULE_PATH=github.com/example/generated-api

# Logging (same semantics as the generated API).
LOG_LEVEL=INFO
HEXAPI_LOG_LEVEL=DEBUG
LOG_FORMAT=text
