		return {{.EntityName}}{}, err
	}
	return {{.EntityName}}{
{{range .Columns}}		{{.GoName}}: {{.GoName}},
{{end}}	}, nil
}

func validate{{.EntityName}}({{range .Columns}}{{.GoName}} {{.GoType}}, {{end}}) error {
{{range .Columns}}{{if .Required}}	if {{.GoName}} == {{.ZeroValue}} {
		return {{$.EntityName}}DomainError{Field: "{{.Name}}", Message: "is required"}
	}
{{end}}{{end}}	return nil
}

