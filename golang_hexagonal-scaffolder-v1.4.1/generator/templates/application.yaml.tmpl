{{/* template: application.yaml.tmpl
   Default config for the generated API (env vars override). Since 1.4.0. */}}
db:
  host: postgres
  port: 5432
  user: hexapi
  name: hexapi_db
  pool_size: 10
  max_overflow: 20
  conn_timeout: 5

http:
  port: 8080
  cors_allowed_origins: http://localhost:8080
  rate_limit_rpm: 100
  graceful_shutdown_timeout: 5

auth:
  jwt_secret: ""
  jwt_issuer: hexapi
  jwt_ttl_minutes: 60

logging:
  level: INFO
  hexapi_level: DEBUG
  format: json
