# =============================================================================
# hexagonal-scaffolder — root environment template
# Copy this file to ".env" at the repository root and fill in real values.
# docker-compose.yml reads POSTGRES_PASSWORD from .env and will REFUSE to start
# if it is missing or empty (see the "${POSTGRES_PASSWORD:?...}" expansion).
# NEVER commit a real ".env" file. ".env" is in .gitignore.
# =============================================================================

# --- PostgreSQL (shared by generator introspection and generated-api runtime) -
# REQUIRED. docker-compose will fail fast if this is unset or empty.
POSTGRES_USER=hexapi
POSTGRES_PASSWORD=__REPLACE_ME__

# Database name used by the generated API runtime.
POSTGRES_DB=hexapi_db

# Host/port the services use to reach PostgreSQL inside the compose network.
# Keep these as-is for `docker compose up`; override only for non-compose runs.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Connection pool tuning (generated-api runtime) --------------------------
# Maximum number of cached database connections.
DB_POOL_SIZE=10
# Additional connections allowed beyond DB_POOL_SIZE under burst load.
DB_MAX_OVERFLOW=20
# Seconds to wait for an idle connection before timing out.
DB_CONN_TIMEOUT=5

# --- HTTP server (generated-api runtime) -------------------------------------
HTTP_PORT=8080
# Comma-separated list of allowed CORS origins. Never use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Per-IP rate limit, requests per minute. 0 disables rate limiting.
RATE_LIMIT_RPM=100
# Seconds to drain in-flight requests on SIGTERM before forcing shutdown.
GRACEFUL_SHUTDOWN_TIMEOUT=5

# --- Logging (BOTH projects) -------------------------------------------------
# Root log level: one of DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO
# Per-package override for the hexapi code paths (e.g. to trace the generator).
HEXAPI_LOG_LEVEL=DEBUG
# Output format: "json" (structured, for log aggregators) or "text" (human).
LOG_FORMAT=json

# --- Auth (generated-api runtime) --------------------------------------------
# HMAC signing key for JWT tokens. REQUIRED in any non-dev environment.
JWT_SECRET=__REPLACE_ME__
JWT_ISSUER=hexapi
# Token lifetime in minutes.
JWT_TTL_MINUTES=60

# --- Generator ---------------------------------------------------------------
# Output directory the generator writes the scaffold into.
GENERATOR_OUTPUT_DIR=./out
# Go module path the generator stamps into generated go.mod files.
GENERATOR_MODULE_PATH=github.com/example/generated-api
